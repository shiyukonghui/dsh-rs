{
  "name": "probe-nested-group",
  "plugins": {
    "provider": { "name": "provider", "apply": [{ "op": "provide", "service": "svc", "value": "root" }] },
    "consumer": { "name": "consumer", "inject": ["svc"], "apply": [{ "op": "log", "text": "consumer-applied" }] }
  },
  "steps": [
    { "op": "loader-sync", "entries": [
      { "id": "g1", "name": "group", "group": true, "config": [
        { "id": "p", "name": "provider" },
        { "id": "gInner", "name": "group", "group": true, "config": [
          { "id": "c1", "name": "consumer" }
        ] }
      ] }
    ] }
  ]
}
