{
  "$schema": "dsh/plugin-ui/v2",
  "kind": "card",
  "cardId": "panel-schedule.list",
  "type": "runtime",
  "title": "调度任务",
  "description": "after/at/every 调度记录（只读；协议在宿主事件日志权威）",
  "size": { "w": 4, "h": 4 },
  "view": {
    "kind": "list",
    "dataRpc": ["schedule", "list"],
    "columns": [
      { "key": "id", "label": "ID" },
      { "key": "kind", "label": "类型" },
      { "key": "prompt", "label": "提示" },
      { "key": "scheduledAt", "label": "计划时间" }
    ],
    "rowsPath": "items",
    "actions": [],
    "rowActions": [
      { "name": "delete", "label": "删除", "rpc": ["schedule", "delete"],
        "scope": "row", "confirm": true }
    ],
    "emptyText": "没有调度记录"
  }
}
