{
  "$schema": "dsh.panel-ui/v2",
  "kind": "card",
  "cardId": "panel-schedule.list",
  "type": "runtime",
  "title": {
    "zh": "调度任务",
    "en": "Scheduled Tasks"
  },
  "description": {
    "zh": "after/at/every 调度记录（只读；协议在宿主事件日志权威）",
    "en": "after/at/every schedules (read-only; host event log is authoritative)"
  },
  "size": {
    "w": 4,
    "h": 4
  },
  "view": {
    "kind": "list",
    "dataRpc": [
      "schedule",
      "list"
    ],
    "columns": [
      {
        "key": "id",
        "label": "ID"
      },
      {
        "key": "kind",
        "label": {
          "zh": "类型",
          "en": "Type"
        }
      },
      {
        "key": "prompt",
        "label": {
          "zh": "提示",
          "en": "Prompt"
        }
      },
      {
        "key": "scheduledAt",
        "label": {
          "zh": "计划时间",
          "en": "Planned At"
        }
      }
    ],
    "rowsPath": "items",
    "actions": [],
    "rowActions": [
      {
        "name": "delete",
        "label": {
          "zh": "删除",
          "en": "Delete"
        },
        "rpc": [
          "schedule",
          "delete"
        ],
        "scope": "row",
        "confirm": true
      }
    ],
    "emptyText": {
      "zh": "没有调度记录",
      "en": "No schedule records"
    }
  }
}
