// panel-dynamic-plugins 服务装配单元（面板改写 #3，D-188）：动态插件清单卡。
//
// 复用 `dsh:host-remote/remote` 与 `dsh:host-remote/host-services` 同一接口身份：
// 宿主 `WasmRemoteEndpointPlugin` 零改动即可加载（namespace = panel-dynamic-plugins）。
package dsh:panel-dynamic-plugins;

use dsh:host-remote/remote;
use dsh:host-remote/host-services;

world panel-dynamic-plugins {
  export remote;
  import host-services;
}
