{
  "$schema": "dsh.panel-ui/v2",
  "kind": "card",
  "cardId": "panel-schedule-create.form",
  "type": "runtime",
  "title": {
    "zh": "创建调度",
    "en": "Create Schedule"
  },
  "description": {
    "zh": "after/at/every 调度创建（写端；动作走宿主 schedule/create 臂）",
    "en": "Create after/at/every schedule (writes via host schedule/create)"
  },
  "size": {
    "w": 2,
    "h": 4
  },
  "view": {
    "kind": "form",
    "fields": [
      {
        "name": "kind",
        "label": {
          "zh": "类型",
          "en": "Type"
        },
        "type": "select",
        "options": [
          "after",
          "at",
          "every"
        ],
        "default": "after",
        "required": true
      },
      {
        "name": "prompt",
        "label": {
          "zh": "提示",
          "en": "Prompt"
        },
        "type": "text",
        "required": true
      },
      {
        "name": "afterSeconds",
        "label": {
          "zh": "延迟秒（after）",
          "en": "Delay seconds (after)"
        },
        "type": "number",
        "default": 60
      }
    ],
    "actions": [
      {
        "name": "create",
        "label": {
          "zh": "创建",
          "en": "Create"
        },
        "rpc": [
          "schedule",
          "create"
        ],
        "primary": true
      }
    ]
  }
}
